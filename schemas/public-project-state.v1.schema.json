{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haleyparks329.github.io/schemas/public-project-state.v1.schema.json",
  "title": "PublicProjectState collection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "freshness", "projects"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "freshness": { "type": "object" },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    }
  }
}
