{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haleyparks329.github.io/schemas/world-projection.v1.schema.json",
  "title": "WorldProjection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectionId",
    "generatedAt",
    "status",
    "places",
    "residents",
    "activities",
    "attention"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "projectionId": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["current", "stale", "partial"] },
    "places": { "type": "array" },
    "residents": { "type": "array" },
    "activities": { "type": "array" },
    "attention": { "type": "array" }
  }
}
