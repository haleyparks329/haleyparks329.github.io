{
  "name": "haleyparks329.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:site",
    "build:site": "npm run validate:memories && npm run validate:projections && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:relationships": "node --experimental-strip-types scripts/validate-relationships.ts",
    "validate:memories": "node scripts/validate-memories.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:structure": "node --experimental-strip-types scripts/validate-site-structure.mjs",
    "projections:generate": "node scripts/generate-projections.mjs",
    "projections:publish": "node scripts/publish-projections.mjs",
    "projections:rollback": "node scripts/rollback-projections.mjs",
    "validate:projections": "node scripts/validate-projections.mjs",
    "check:projection-health": "node scripts/check-projection-health.mjs",
    "test:projections": "node --test tests/projection-pipeline.test.mjs",
    "maintenance:check": "npm run validate:memories && npm run validate:relationships && npm run validate:projections && npm run check:projection-health && npm run validate:assets && npm run check && npm run build:site && npm run validate:structure && npm run validate:links",
    "validate": "npm run format:check && npm run test:projections && npm run maintenance:check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^7.0.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
