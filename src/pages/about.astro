---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/site.config";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout
  title={`About — ${siteConfig.name}`}
  description={siteConfig.description}
  canonicalPath="/about/"
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "About" }]}
>
  <article class="maria-page about-page">
    <header class="maria-collection-head about-hero">
      <p class="maria-eyebrow">About</p>
      <h1>{siteConfig.tagline}</h1>
      <p>{siteConfig.description}</p>
    </header>

    <dl class="about-facts" aria-label="Profile">
      <div>
        <dt>Role</dt>
        <dd>{siteConfig.role}</dd>
      </div>
      <div>
        <dt>Based in</dt>
        <dd>{siteConfig.location}</dd>
      </div>
      <div>
        <dt>Focus</dt>
        <dd>Data, behavior, context, and goals</dd>
      </div>
    </dl>

    <section class="about-section" aria-labelledby="work-heading">
      <div>
        <p class="maria-eyebrow">Public work</p>
        <h2 id="work-heading">
          Systems that keep evidence and human context visible.
        </h2>
      </div>
      <div class="about-copy">
        <p>
          The projects on this site explore source-backed human models,
          persistent computational environments, bounded AI investigation, and
          the interfaces that make those systems understandable.
        </p>
        <p>
          The writing develops the same questions in another form: how to
          preserve context, build evidence before autonomy, and design tools for
          whole people.
        </p>
      </div>
    </section>

    <section class="about-projects" aria-labelledby="projects-heading">
      <header>
        <p class="maria-eyebrow">Selected projects</p>
        <h2 id="projects-heading">Current public work</h2>
      </header>
      <ol>
        {
          projects.map((project) => (
            <li>
              <article>
                <p>{project.data.status}</p>
                <h3>
                  <a href={`/projects/${project.data.slug}/`}>
                    {project.data.title}
                  </a>
                </h3>
                <p>{project.data.summary}</p>
              </article>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="about-section" aria-labelledby="availability-heading">
      <div>
        <p class="maria-eyebrow">Availability</p>
        <h2 id="availability-heading">Open to relevant opportunities.</h2>
      </div>
      <div class="about-copy">
        <p>{siteConfig.availability}</p>
      </div>
    </section>

    <section class="maria-contact" aria-labelledby="contact-heading">
      <div>
        <p class="maria-eyebrow">Contact</p>
        <h2 id="contact-heading">Get in touch.</h2>
      </div>
      <div>
        <p>
          <a href={`mailto:${siteConfig.email}`}>Email</a> · <a
            href={siteConfig.linkedinUrl}
            rel="me">LinkedIn</a
          > · <a href={siteConfig.githubUrl} rel="me">GitHub</a>
        </p>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .about-hero {
    max-width: 68rem;
  }

  .about-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 0 clamp(5rem, 9vw, 8rem);
    border-block: 1px solid var(--maria-line);
  }

  .about-facts div {
    padding: 1.25rem 1.5rem 1.25rem 0;
  }

  .about-facts div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--maria-line);
  }

  .about-facts dt,
  .about-projects article > p:first-child {
    color: var(--maria-muted);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-facts dd {
    margin: 0.25rem 0 0;
  }

  .about-section {
    display: grid;
    grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    padding-bottom: clamp(5rem, 9vw, 8rem);
  }

  .about-section h2,
  .about-projects h2,
  .about-projects h3 {
    margin: 0;
    font-family: var(--maria-display);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .about-section h2,
  .about-projects h2 {
    font-size: clamp(2rem, 4vw, 3.3rem);
    line-height: 1.05;
  }

  .about-copy {
    max-width: 42rem;
    font-size: 1.08rem;
  }

  .about-copy p:first-child {
    margin-top: 0;
  }

  .about-projects {
    display: grid;
    grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    margin-bottom: clamp(5rem, 9vw, 8rem);
    padding-block: clamp(4rem, 7vw, 6rem);
    border-block: 1px solid var(--maria-line);
  }

  .about-projects ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-projects li + li {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--maria-line);
  }

  .about-projects article > p:first-child {
    margin: 0 0 0.5rem;
  }

  .about-projects h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .about-projects h3 a {
    text-underline-offset: 0.15em;
  }

  .about-projects h3 + p {
    margin-bottom: 0;
    color: var(--maria-muted);
  }

  @media (max-width: 48rem) {
    .about-facts,
    .about-section,
    .about-projects {
      grid-template-columns: 1fr;
    }

    .about-facts div + div {
      padding-left: 0;
      border-top: 1px solid var(--maria-line);
      border-left: 0;
    }
  }
</style>
