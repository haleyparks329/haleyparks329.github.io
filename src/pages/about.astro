---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import ContinueExploring from "../components/ContinueExploring.astro";
---

<BaseLayout
  title="About — Haley Parks"
  description="How Haley Parks approaches product strategy, research, systems, and the work of making complex things useful."
>
  <article class="site-shell about-page">
    <PageIntro
      eyebrow="About"
      title="I make complex systems easier to understand and use."
      description="My work sits between product strategy, research, operations, and the careful translation required to turn ambiguity into something people can act on."
      meta={["Haley Parks", "Copenhagen"]}
    />

    <div class="about-flow reading-column">
      <section class="about-section split-section">
        <h2>How I think</h2>
        <div>
          <p>
            I am drawn to problems that are difficult for more than one reason:
            the information is incomplete, the system has many owners, and the
            people inside it do not share the same mental model.
          </p>
          <p>
            My contribution is usually a combination of listening, structuring,
            and making. I look for the decisions hidden inside the noise, create
            a useful model of the situation, and build the smallest credible
            thing that helps a team move.
          </p>
        </div>
      </section>

      <section class="belief-section" aria-labelledby="belief-heading">
        <p class="eyebrow">A working belief</p>
        <h2 id="belief-heading">
          Good systems should make people feel more capable, not more managed.
        </h2>
        <p>
          That standard applies whether I am shaping a product, designing a
          research practice, documenting a process, or building this site.
        </p>
      </section>

      <section class="about-section split-section">
        <h2>What shapes the work</h2>
        <div class="work-threads">
          <div class="work-thread">
            <h3>Product and organizational systems</h3>
            <p>
              I have worked across complex service environments where strategy,
              delivery, policy, data, and frontline experience all meet. That
              work taught me to treat operating reality as part of the
              product—not as an implementation detail.
            </p>
            <a href="/projects/"
              >See selected projects <span aria-hidden="true">→</span></a
            >
          </div>
          <div class="work-thread">
            <h3>Learning in public</h3>
            <p>
              Writing is how I test ideas, preserve useful context, and notice
              connections between domains. The site keeps polished essays,
              project evidence, and smaller observations distinct without
              pretending they are unrelated.
            </p>
            <a href="/writing/"
              >Browse the writing library <span aria-hidden="true">→</span></a
            >
          </div>
        </div>
      </section>

      <section class="about-section principles-section">
        <div>
          <p class="eyebrow">Principles</p>
          <h2>What I try to bring to the room</h2>
        </div>
        <ul>
          <li>
            <strong>Clarity without false certainty.</strong> Name what is known,
            what is assumed, and what still needs to be learned.
          </li>
          <li>
            <strong>Respect for lived expertise.</strong> The people closest to a
            system often understand its real constraints best.
          </li>
          <li>
            <strong>Evidence that travels.</strong> Research matters when it can survive
            the meeting where the researcher is absent.
          </li>
          <li>
            <strong>Care in the details.</strong> Small choices accumulate into trust,
            friction, and the quality of an experience.
          </li>
        </ul>
      </section>

      <section class="contact-section" aria-labelledby="contact-heading">
        <div>
          <p class="eyebrow">Contact</p>
          <h2 id="contact-heading">
            A useful conversation is a good place to start.
          </h2>
        </div>
        <div>
          <p>
            If you are working through a complicated product or organizational
            question, I am always interested in comparing notes.
          </p>
          <nav aria-label="Contact links">
            <a href="mailto:hello@haleyparks.com">Email</a>
            <a href="https://www.linkedin.com/in/haleyparks/" rel="me"
              >LinkedIn</a
            >
          </nav>
        </div>
      </section>
    </div>

    <ContinueExploring
      title="Continue exploring"
      links={[
        {
          href: "/projects/",
          label: "Projects",
          type: "Page",
          summary: "Selected systems, research, and product work.",
          topics: [],
        },
        {
          href: "/writing/",
          label: "Writing",
          type: "Page",
          summary: "Essays and notes on making sense of complex work.",
          topics: [],
        },
        {
          href: "/explore/",
          label: "Explore",
          type: "Page",
          summary: "A map of the ideas and artifacts across this site.",
          topics: [],
        },
      ]}
    />
  </article>
</BaseLayout>

<style>
  .about-page {
    padding-bottom: var(--space-8);
  }

  .about-flow {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-6);
  }

  .about-section {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-5);
  }

  .split-section {
    display: grid;
    grid-template-columns: minmax(9rem, 0.7fr) minmax(0, 1.8fr);
    gap: var(--space-5);
  }

  .about-section h2,
  .belief-section h2,
  .contact-section h2 {
    margin: 0;
    text-wrap: balance;
  }

  .split-section p:first-child {
    margin-top: 0;
  }

  .belief-section {
    border-block: 1px solid var(--color-border-strong, var(--color-border));
    padding: var(--space-6) 0;
  }

  .belief-section h2 {
    max-width: 23ch;
    font-size: clamp(1.75rem, 4vw, 3.25rem);
  }

  .belief-section > p:last-child {
    max-width: 58ch;
    margin-bottom: 0;
  }

  .eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .work-threads {
    display: grid;
    gap: var(--space-5);
  }

  .work-thread + .work-thread {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-5);
  }

  .work-thread h3 {
    margin-top: 0;
  }

  .work-thread a,
  .contact-section a {
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .principles-section {
    display: grid;
    grid-template-columns: minmax(12rem, 0.9fr) minmax(0, 1.6fr);
    gap: var(--space-5);
  }

  .principles-section ul {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .principles-section li {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-3);
  }

  .contact-section {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) minmax(0, 1fr);
    gap: var(--space-5);
    border-block: 1px solid var(--color-border);
    padding: var(--space-6) 0;
  }

  .contact-section p {
    margin-top: 0;
  }

  .contact-section nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (max-width: 720px) {
    .split-section,
    .principles-section,
    .contact-section {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
