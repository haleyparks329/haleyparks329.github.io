---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/site.config";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout
  title={`About — ${siteConfig.name}`}
  description={siteConfig.description}
  canonicalPath="/about/"
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "About" }]}
>
  <article class="maria-page about-page">
    <header class="maria-collection-head about-hero">
      <p class="maria-eyebrow">About</p>
      <h1>Hi, I’m Haley.</h1>
      <p>
        I’m an AI Product Engineer and systems person who likes figuring out
        where the human is doing work the computer should have been doing all
        along.
      </p>
      <p>
        Most of what I build sits somewhere between software engineering,
        product thinking, data, AI, and human-computer interaction. I tend to
        start with an irritation—why am I entering this again? Why did this
        context disappear? Why does this system need me to remember how it
        works?—and keep pulling on it until it turns into an architecture
        problem.
      </p>
    </header>

    <dl class="about-facts" aria-label="Profile">
      <div>
        <dt>Role</dt>
        <dd>AI Product Engineer</dd>
      </div>
      <div>
        <dt>Based in</dt>
        <dd>{siteConfig.location}</dd>
      </div>
      <div>
        <dt>Focus</dt>
        <dd>Human-centered interaction systems</dd>
      </div>
    </dl>

    <section class="about-section" aria-labelledby="work-heading">
      <div>
        <p class="maria-eyebrow">Public work</p>
        <h2 id="work-heading">
          I build systems that make the computer carry more of the system.
        </h2>
      </div>
      <div class="about-copy">
        <p>
          I am interested in persistent state, provenance, adaptive interfaces,
          bounded autonomy, observability, and models that can change without
          pretending uncertainty disappeared.
        </p>
        <p>
          The Human Model asks how software can represent a changing person.
          Wonderful Digital World asks why the person is still responsible for
          orchestrating all the software around them. Bridget explores
          continuity across that world. QA Agents explores evidence and
          authority before action. Career Intelligence asks what happens when
          career reasoning starts with the person’s evidence instead of the
          document meant to summarize it.
        </p>
        <p>
          They look like different projects, but they keep running into the same
          underlying idea: technology should fit the person better than the
          person has to fit the technology.
        </p>
      </div>
    </section>

    <section class="about-section" aria-labelledby="philosophy-heading">
      <div>
        <p class="maria-eyebrow">Philosophy</p>
        <h2 id="philosophy-heading">
          Human-centered is an engineering constraint.
        </h2>
      </div>
      <div class="about-copy">
        <p>
          For me, human-centered technology is not just friendly copy or a nicer
          interface. It changes where state lives, how much context a system
          asks a person to repeat, whether uncertainty is visible, how expensive
          it is to change your mind, what an agent is allowed to do, and whether
          the interface can adapt without becoming the source of truth.
        </p>
        <p>
          I want the human doing the human things: intent, judgment, creativity,
          taste, consent, correction, meaning. I want the computer doing more of
          the persistence, retrieval, routing, synchronization, bookkeeping,
          evidence gathering, and state tracking.
        </p>
        <p>
          The goal is not to automate being human. The goal is to stop making
          humans operate computers quite so much.
        </p>
      </div>
    </section>

    <section class="about-projects" aria-labelledby="projects-heading">
      <header>
        <p class="maria-eyebrow">Selected projects</p>
        <h2 id="projects-heading">Current public work</h2>
      </header>
      <ol>
        {
          projects.map((project) => (
            <li>
              <article>
                <p>{project.data.status}</p>
                <h3>
                  <a href={`/projects/${project.data.slug}/`}>
                    {project.data.title}
                  </a>
                </h3>
                <p>{project.data.summary}</p>
              </article>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="about-section" aria-labelledby="availability-heading">
      <div>
        <p class="maria-eyebrow">Availability</p>
        <h2 id="availability-heading">
          I’m looking for smart people building interesting things.
        </h2>
      </div>
      <div class="about-copy">
        <p>
          I’m especially interested in engineering roles where product judgment,
          systems thinking, AI, and human-centered design overlap. The title
          matters less to me than the chance to build useful, technically
          serious things with people who care how the system feels to the humans
          inside it.
        </p>
      </div>
    </section>

    <section class="maria-contact" aria-labelledby="contact-heading">
      <div>
        <p class="maria-eyebrow">Contact</p>
        <h2 id="contact-heading">Come say hi.</h2>
      </div>
      <div>
        <p>
          <a href={`mailto:${siteConfig.email}`}>Email</a> · <a
            href={siteConfig.linkedinUrl}
            rel="me">LinkedIn</a
          > · <a href={siteConfig.githubUrl} rel="me">GitHub</a>
        </p>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .about-hero {
    max-width: 68rem;
  }

  .about-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 0 clamp(5rem, 9vw, 8rem);
    border-block: 1px solid var(--maria-line);
  }

  .about-facts div {
    padding: 1.25rem 1.5rem 1.25rem 0;
  }

  .about-facts div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--maria-line);
  }

  .about-facts dt,
  .about-projects article > p:first-child {
    color: var(--maria-muted);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-facts dd {
    margin: 0.25rem 0 0;
  }

  .about-section {
    display: grid;
    grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    padding-bottom: clamp(5rem, 9vw, 8rem);
  }

  .about-section h2,
  .about-projects h2,
  .about-projects h3 {
    margin: 0;
    font-family: var(--maria-display);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .about-section h2,
  .about-projects h2 {
    font-size: clamp(2rem, 4vw, 3.3rem);
    line-height: 1.05;
  }

  .about-copy {
    max-width: 42rem;
    font-size: 1.08rem;
  }

  .about-copy p:first-child {
    margin-top: 0;
  }

  .about-projects {
    display: grid;
    grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    margin-bottom: clamp(5rem, 9vw, 8rem);
    padding-block: clamp(4rem, 7vw, 6rem);
    border-block: 1px solid var(--maria-line);
  }

  .about-projects ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-projects li + li {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--maria-line);
  }

  .about-projects article > p:first-child {
    margin: 0 0 0.5rem;
  }

  .about-projects h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .about-projects h3 a {
    text-underline-offset: 0.15em;
  }

  .about-projects h3 + p {
    margin-bottom: 0;
    color: var(--maria-muted);
  }

  @media (max-width: 48rem) {
    .about-facts,
    .about-section,
    .about-projects {
      grid-template-columns: 1fr;
    }

    .about-facts div + div {
      padding-left: 0;
      border-top: 1px solid var(--maria-line);
      border-left: 0;
    }
  }
</style>
