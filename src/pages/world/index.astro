---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { cutawayScene } from "../../data/world-cutaway";
import { loadWorldView } from "../../data/world-view";
import { withBasePath } from "../../utils/site-path";

const worldView = await loadWorldView();
const projection =
  worldView.state === "unavailable" ? null : worldView.projection;
const scene = cutawayScene(projection);
const basePath = import.meta.env.BASE_URL;
const projectHref = withBasePath(
  "/projects/wonderful-digital-world/",
  basePath,
);
const formatDay = (value: string): string =>
  new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(value));
const formatDate = (value: string): string =>
  new Intl.DateTimeFormat("en", {
    dateStyle: "medium",
    timeStyle: "short",
    timeZone: "UTC",
  }).format(new Date(value));
const day = projection ? formatDay(projection.generatedAt) : null;
const sceneLabel = projection
  ? `Cutaway drawing of the residents' house on ${day}. ` +
    (scene.residents.length
      ? scene.residents
          .map((r) => `${r.name} in the ${r.areaName}, ${r.statusLabel}`)
          .join("; ") + "."
      : "No residents were published.")
  : "Cutaway drawing of the residents' house. The projection could not be verified, so no residents are shown.";
---

<BaseLayout
  title="World View"
  description="Yesterday in Wonderful Digital World: a cutaway house showing each resident's published status."
  canonicalPath="/world/"
>
  <article class="world-page">
    <header class="world-intro">
      <p class="world-eyebrow">World View · Wonderful Digital World</p>
      <h1>Yesterday in the world</h1>
      <p>
        {
          day
            ? `This view runs 24 hours behind on purpose, so it shows the world as it was on ${day}.`
            : "This view runs 24 hours behind on purpose."
        }
      </p>
    </header>

    <div class="cutaway-scroll">
      <div class="cutaway" role="img" aria-label={sceneLabel}>
        <div class="cutaway__roof" aria-hidden="true"></div>
        <div class="cutaway__house" aria-hidden="true">
          <div class="cutaway__room">
            <span class="cutaway__room-name">{scene.roomNames.workshop}</span>
            <span class="cutaway__desk"></span>
            <span class="cutaway__screen"></span>
          </div>
          <div class="cutaway__room">
            <span class="cutaway__room-name">{scene.roomNames.lab}</span>
            <span class="cutaway__bench"></span>
            <span class="cutaway__flask"></span>
            <span class="cutaway__flask cutaway__flask--two"></span>
          </div>
        </div>
        <span class="cutaway__outside-name" aria-hidden="true"
          >{scene.roomNames.outside}</span
        >
        <span class="cutaway__trunk" aria-hidden="true"></span>
        <span class="cutaway__canopy" aria-hidden="true"></span>
        <span class="cutaway__heap" aria-hidden="true"></span>
        <span class="cutaway__flower" aria-hidden="true"></span>
        <span class="cutaway__flower cutaway__flower--two" aria-hidden="true"
        ></span>
        <div class="cutaway__ground" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </div>
        {
          scene.residents.map((resident) => (
            <div
              class:list={[
                "resident",
                `resident--${resident.tone}`,
                `resident--${resident.pose}`,
              ]}
              style={`left: ${resident.left}%`}
              aria-hidden="true"
            >
              {resident.tone === "bridget" && <span class="resident__crown" />}
              <span class="resident__name">{resident.name}</span>
              {resident.pose !== "busy" && (
                <span class="resident__tag">
                  {resident.pose === "away" ? "away" : resident.statusLabel}
                </span>
              )}
            </div>
          ))
        }
      </div>
    </div>

    <ul class="world-roster" aria-label="Residents and their published status">
      {
        scene.residents.map((resident) => (
          <li>
            <span
              class:list={["world-roster__dot", `resident--${resident.tone}`]}
              aria-hidden="true"
            />
            <strong>{resident.name}</strong>
            <span>{resident.role}</span>
            <span>
              {resident.areaName} · {resident.statusLabel}
            </span>
          </li>
        ))
      }
      {scene.residents.length === 0 && <li>No residents are published.</li>}
    </ul>

    <aside class:list={["world-status", `world-status--${worldView.state}`]}>
      <span aria-hidden="true"></span>
      <div>
        <strong>Projection state · {worldView.state}</strong>
        {
          worldView.state !== "unavailable" ? (
            <small>
              Published {formatDate(worldView.projection.generatedAt)} UTC
            </small>
          ) : (
            <small>{worldView.reason}</small>
          )
        }
      </div>
    </aside>

    <section class="world-about" aria-labelledby="world-about-heading">
      <div>
        <p class="world-kicker">About this view</p>
        <h2 id="world-about-heading">
          An authorized projection, not the world.
        </h2>
      </div>
      <div class="world-about__copy">
        <p>
          This is an authorized, noncanonical, replaceable projection of
          Wonderful Digital World. It may lag or omit private state, so absence
          here is not evidence that something is absent from the world.
        </p>
        <p>
          The house is drawn on the server from the published projection. Each
          resident shows one public status: busy residents work at the desk or
          bench, idle ones rest by the wall, and unavailable ones are faded.
          Nothing here is live.
        </p>
        <div class="world-links">
          <a href={projectHref}>WDW project + architecture</a>
          <a
            href="https://github.com/Wonderful-Digital-World/wonderful-digital-world"
            rel="noreferrer">WDW repository ↗</a
          >
          <a
            href="https://github.com/haleyparks329/haleyparks329.github.io"
            rel="noreferrer">Website repository ↗</a
          >
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .world-page {
    --scene-wall: #ece5d8;
    --scene-frame: #8d8174;
    --scene-roof: #c9a3a6;
    --scene-desk: #dcc191;
    --scene-screen: #4a4540;
    --scene-bench: #b9c2b8;
    --scene-leaf: #9aa58a;
    --scene-trunk: #9a7a4f;
    --scene-heap: #c8ab84;
    --scene-soil-1: #ddd3e6;
    --scene-soil-2: #d3d4bd;
    --scene-soil-3: #e6d5b3;
    --scene-soil-4: #cdd5cf;
    --eye-white: #fffdf8;
    --eye-pupil: #1e1e1e;
    --tone-bridget: #c2647f;
    --tone-mini-me: #a78bfa;
    --tone-coach: var(--maria-olive);
    --tone-banjo: #c49a53;
    --tone-other: #8c9c98;

    width: min(calc(100% - 2rem), 78rem);
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 5rem) 0 clamp(4rem, 8vw, 7rem);
  }
  .world-intro {
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }
  .world-eyebrow,
  .world-kicker {
    margin: 0 0 0.4rem;
    color: var(--maria-muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .world-intro h1,
  .world-about h2 {
    margin: 0;
    font-family: var(--maria-display);
    font-weight: 500;
    line-height: 1.1;
  }
  .world-intro h1 {
    font-size: var(--text-page-title);
    letter-spacing: -0.02em;
  }
  .world-intro > p:last-child {
    max-width: 42rem;
    margin: 0.7rem 0 0;
    color: var(--maria-muted);
  }

  /* The scene keeps its proportions and scrolls sideways on small screens. */
  .cutaway-scroll {
    overflow-x: auto;
    border: 1px solid var(--maria-line);
    border-radius: 0.6rem;
    background: var(--maria-surface);
  }
  .cutaway {
    position: relative;
    min-width: 40rem;
    aspect-ratio: 16 / 8.5;
    overflow: hidden;
  }
  .cutaway__roof {
    position: absolute;
    top: 9%;
    left: 2%;
    width: 65%;
    height: 13.5%;
    background: var(--scene-roof);
    clip-path: polygon(0 100%, 50% 0, 100% 100%);
  }
  .cutaway__house {
    position: absolute;
    top: 22%;
    left: 4%;
    width: 61%;
    height: 52%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 2px solid var(--scene-frame);
    border-bottom: 0;
    background: var(--scene-wall);
  }
  .cutaway__room {
    position: relative;
  }
  .cutaway__room + .cutaway__room {
    border-left: 2px solid var(--scene-frame);
  }
  .cutaway__room-name,
  .cutaway__outside-name {
    position: absolute;
    color: var(--maria-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cutaway__room-name {
    top: 6%;
    left: 6%;
  }
  .cutaway__outside-name {
    top: 38%;
    left: 70%;
  }
  .cutaway__desk {
    position: absolute;
    bottom: 0;
    left: 58%;
    width: 26%;
    height: 22%;
    border-radius: 3px 3px 0 0;
    background: var(--scene-desk);
  }
  .cutaway__screen {
    position: absolute;
    bottom: 22%;
    left: 64%;
    width: 13%;
    height: 14%;
    border-radius: 2px;
    background: var(--scene-screen);
  }
  .cutaway__bench {
    position: absolute;
    bottom: 0;
    left: 60%;
    width: 34%;
    height: 18%;
    border-radius: 3px 3px 0 0;
    background: var(--scene-bench);
  }
  .cutaway__flask {
    position: absolute;
    bottom: 18%;
    left: 66%;
    width: 5%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--tone-mini-me);
    opacity: 0.6;
  }
  .cutaway__flask--two {
    left: 78%;
    background: var(--tone-coach);
  }
  .cutaway__trunk {
    position: absolute;
    bottom: 26%;
    left: 86.5%;
    width: 1.6%;
    height: 16%;
    background: var(--scene-trunk);
  }
  .cutaway__canopy {
    position: absolute;
    bottom: 38%;
    left: 81%;
    width: 13%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--scene-leaf);
  }
  .cutaway__heap {
    position: absolute;
    bottom: 26%;
    left: 70%;
    width: 12%;
    height: 7%;
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    background: var(--scene-heap);
  }
  .cutaway__flower {
    position: absolute;
    bottom: 33.5%;
    left: 73%;
    width: 1.1%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--maria-rust);
  }
  .cutaway__flower--two {
    left: 77%;
    background: var(--tone-banjo);
  }
  .cutaway__ground {
    position: absolute;
    inset: 74% 0 0;
    display: grid;
    grid-template-rows: repeat(4, 1fr);
    border-top: 2px solid var(--scene-frame);
  }
  .cutaway__ground span:nth-child(1) {
    background: var(--scene-soil-1);
  }
  .cutaway__ground span:nth-child(2) {
    background: var(--scene-soil-2);
  }
  .cutaway__ground span:nth-child(3) {
    background: var(--scene-soil-3);
  }
  .cutaway__ground span:nth-child(4) {
    background: var(--scene-soil-4);
  }

  .resident {
    position: absolute;
    bottom: 26%;
    width: 4.2%;
    aspect-ratio: 1 / 1.15;
    border-radius: 50% 50% 42% 42%;
    background: var(--tone);
  }
  .resident::before,
  .resident::after {
    content: "";
    position: absolute;
    top: 32%;
    width: 24%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 62%,
      var(--eye-pupil) 0 36%,
      var(--eye-white) 40%
    );
  }
  .resident::before {
    left: 20%;
  }
  .resident::after {
    right: 20%;
  }
  .resident--bridget {
    --tone: var(--tone-bridget);
  }
  .resident--mini-me {
    --tone: var(--tone-mini-me);
  }
  .resident--coach {
    --tone: var(--tone-coach);
  }
  .resident--banjo {
    --tone: var(--tone-banjo);
  }
  .resident--other {
    --tone: var(--tone-other);
  }
  .resident__crown {
    position: absolute;
    bottom: 96%;
    left: 28%;
    width: 44%;
    height: 26%;
    background: var(--tone-banjo);
    clip-path: polygon(
      0 100%,
      0 30%,
      25% 65%,
      50% 0,
      75% 65%,
      100% 30%,
      100% 100%
    );
  }
  .resident__name,
  .resident__tag {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .resident__name {
    bottom: calc(100% + 0.35rem);
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--maria-surface);
    color: var(--maria-ink);
    font-size: 0.62rem;
  }
  .resident--bridget .resident__name {
    bottom: calc(100% + 1.1rem);
  }
  .resident__tag {
    top: calc(100% + 0.3rem);
    padding: 0.05rem 0.35rem;
    border-radius: 999px;
    background: var(--maria-surface);
    color: var(--maria-muted);
    font-size: 0.56rem;
  }
  .resident--busy {
    animation: resident-bob 3.2s ease-in-out infinite;
  }
  .resident--busy:nth-of-type(odd) {
    animation-delay: -1.4s;
  }
  .resident--banjo.resident--busy {
    animation: resident-scurry 2.6s ease-in-out infinite alternate;
  }
  .resident--resting {
    transform: scaleY(0.94);
    transform-origin: bottom;
  }
  .resident--away {
    opacity: 0.38;
    outline: 1.5px dashed var(--scene-frame);
    outline-offset: 2px;
  }
  @keyframes resident-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6%);
    }
  }
  @keyframes resident-scurry {
    0% {
      transform: translateX(-60%);
    }
    45% {
      transform: translateX(40%) translateY(-5%);
    }
    100% {
      transform: translateX(130%);
    }
  }

  .world-roster {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.75rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
  }
  .world-roster li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.5rem;
  }
  .world-roster span {
    color: var(--maria-muted);
  }
  .world-roster__dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--tone);
    align-self: center;
  }

  .world-status {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    max-width: 23rem;
    margin-top: 1.5rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--maria-line);
    border-radius: 0.35rem;
    background: var(--maria-surface);
  }
  .world-status > span {
    width: 0.6rem;
    height: 0.6rem;
    margin-top: 0.35rem;
    border-radius: 50%;
    background: var(--maria-olive);
  }
  .world-status--stale > span,
  .world-status--partial > span {
    background: #b57c24;
  }
  .world-status--unavailable > span {
    background: var(--maria-rust);
  }
  .world-status strong,
  .world-status small {
    display: block;
  }
  .world-status strong {
    font-size: 0.82rem;
  }
  .world-status small {
    margin-top: 0.15rem;
    color: var(--maria-muted);
    font-size: 0.75rem;
  }

  .world-about {
    display: grid;
    grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 8vw, 8rem);
    padding: clamp(2.25rem, 4vw, 3.5rem) 0 0;
  }
  .world-about h2 {
    max-width: 13ch;
    font-size: var(--text-h2);
  }
  .world-about__copy > p {
    max-width: 42rem;
    margin: 0 0 1rem;
  }
  .world-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.3rem;
    margin-top: 1.8rem;
    font-size: 0.8rem;
  }

  @media (max-width: 48rem) {
    .world-about {
      display: block;
    }
    .world-status {
      max-width: none;
    }
    .world-about__copy {
      margin-top: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .resident--busy,
    .resident--banjo.resident--busy {
      animation: none;
    }
  }
</style>
