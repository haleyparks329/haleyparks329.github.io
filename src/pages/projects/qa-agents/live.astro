<BaseLayout
  title="QA Agents | Static evidence"
  description="Why the public QA Agents story uses static case-study evidence."
  canonicalPath="/projects/qa-agents/live/"
>
  <main class="document-page">
    <p class="eyebrow">Boundary update</p>
    <h1>Static evidence, not a live agent runtime</h1>
