---
import ContentTypeLabel from "@/components/ContentTypeLabel.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Extending Deterministic Replay with an Investigation Layer";
const description =
  "A bounded exploration of reasoning downstream of deterministic replay evidence.";
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/projects/qa-agents/meticulous/"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Projects", href: "/projects/" },
    { label: "QA Agents", href: "/projects/qa-agents/" },
    { label: title },
  ]}
>
  <article class="project-note">
    <header class="project-note__header">
      <ContentTypeLabel type="Research note" />
      <h1>{title}</h1>
      <p>{description}</p>
    </header>
    <div class="project-note__body">
      <p>
        This secondary exploration asked how a bounded investigator might reason
        downstream of replay evidence while preserving human merge authority.
      </p>
      <p>
        The public version retains the architectural lesson only. Strategy
        configuration, evidence schemas, prompts, thresholds, clustering, and
        decision policies are intentionally withheld. This is not an official
        integration or representation of another company's internal systems.
      </p>
      <p>
        <a href="/projects/qa-agents/demo/">
          View the primary Little Bytes case study
        </a>
      </p>
    </div>
    <p class="back-link">
      <a href="/projects/qa-agents/">Return to QA Agents</a>
    </p>
  </article>
</BaseLayout>

<style>
  .project-note {
    width: min(var(--site-max-width), calc(100% - (var(--site-gutter) * 2)));
    margin-inline: auto;
  }

  .project-note__header {
    max-width: 50rem;
    padding-block: clamp(3rem, 8vw, 7rem) clamp(2rem, 5vw, 4rem);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .project-note__header h1 {
    max-width: 18ch;
    margin: var(--space-3) 0 var(--space-4);
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .project-note__header > p {
    max-width: 58ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.6;
  }

  .project-note__body {
    max-width: var(--reading-measure);
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .project-note__body p {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font-size: clamp(0.98rem, 1vw, 1.05rem);
    line-height: 1.65;
  }

  .project-note__body a,
  .back-link a {
    color: var(--plum);
    font-weight: 600;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .back-link {
    max-width: var(--reading-measure);
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding-top: var(--space-5);
    padding-bottom: clamp(3rem, 7vw, 6rem);
    border-top: var(--border-width) solid var(--color-border);
  }
</style>
