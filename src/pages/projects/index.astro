---
import { getCollection } from "astro:content";
import EditorialLayout from "../../layouts/EditorialLayout.astro";
import { loadPublicProjections } from "../../data/public-projections.mjs";

// WP6 build-time consumer: fail closed before rendering if the public release is invalid.
await loadPublicProjections();

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const accents: Record<string, string> = {
  rust: "var(--maria-rust)",
  olive: "var(--maria-olive)",
  plum: "var(--maria-plum)",
  blue: "var(--maria-blue)",
  khaki: "#8b8053",
};
---

<EditorialLayout
  title="Projects"
  description="Flagship and supporting systems built and investigated by Haley Parks."
>
  <div class="maria-page">
    <header class="maria-collection-head">
      <p class="maria-eyebrow">Projects</p>
      <h1 class="maria-title" id="projects-title">
        Selected systems and investigations.
      </h1>
      <p class="maria-lede">
        The flagships explore a person and a persistent computational
        environment. Supporting systems investigate the memory, evidence,
        coordination, and quality work needed between them.
      </p>
    </header>
    <section class="maria-work-list" aria-label="All projects">
      {
        projects.map((project) => (
          <article
            class="maria-work-card"
            style={`--card-accent: ${accents[project.data.accent]}`}
          >
            <a href={`/projects/${project.data.slug}/`}>
              <div class="maria-work-card__visual" aria-hidden="true">
                <span />
              </div>
              <div>
                <p class="maria-eyebrow">{project.data.status}</p>
                <h2>{project.data.title}</h2>
                <p>{project.data.summary}</p>
                <div class="maria-work-card__meta">
                  <>
                    <span>{project.data.tags.slice(0, 2).join(" · ")}</span>
                    <span>View project →</span>
                  </>
                </div>
              </div>
            </a>
          </article>
        ))
      }
    </section>
  </div>
</EditorialLayout>
