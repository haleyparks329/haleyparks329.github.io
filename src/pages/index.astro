---
// Home: hello, building philosophies, writing, main projects, other projects, contact.
// Words live in src/data/simple-site.ts; essays come from Substack at build time.
import SimpleLayout from "@/layouts/SimpleLayout.astro";
import { simpleSite as s } from "@/data/simple-site";
import { getSubstackPosts } from "@/data/substack-feed";

const essays = await getSubstackPosts();
const bare = (url: string) => url.replace(/^https:\/\//, "");
---

<SimpleLayout>
  <div class="s-wrap">
    <article class="s-doc">
      <h1>{s.hello}</h1>
      <p class="s-lede">{s.tagline}</p>
      <div class="s-intro">
        {
          s.intro.map((para) => (
            <p>
              {para
                .split(/\*\*(.+?)\*\*/)
                .map((bit, i) => (i % 2 ? <strong>{bit}</strong> : bit))}
            </p>
          ))
        }
      </div>

      <section id="philosophies">
        <h2>Building philosophies</h2>
        <ul>
          {s.philosophies.map((text) => <li>{text}</li>)}
        </ul>
      </section>

      <section id="writing">
        <h2>What I write about</h2>
        <p class="s-sub">
          On Substack: <a href={s.substackUrl}>{bare(s.substackUrl)}</a>
        </p>
        <ul>
          {
            essays.map((post) => (
              <li>
                <a href={post.url}>{post.title}</a>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="main-projects">
        <h2>Main projects</h2>
        <ul class="s-lead">
          {
            s.featured.map((p) => (
              <li>
                <a class="s-b" href={p.href}>
                  {p.title}
                </a>
                . {p.line}
                <span class="s-from">{p.proof}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="other-projects">
        <h2>Other projects</h2>
        <ul>
          {
            s.others.map((p) => (
              <li>
                <span class="s-b">{p.title}</span>. {p.line}
                <span class="s-from">
                  <a href={p.repo}>{bare(p.repo)}</a>
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="contact">
        <h2>Contact me</h2>
        <ul class="s-contact">
          <li>Email: {s.contact.email}</li>
          <li><a href={s.contact.linkedin}>LinkedIn</a></li>
          <li><a href={s.contact.github}>GitHub</a></li>
        </ul>
      </section>
    </article>
  </div>
</SimpleLayout>
