---
import { getCollection } from "astro:content";
import EditorialLayout from "../layouts/EditorialLayout.astro";
import { projectDocumentForSlug } from "../data/project-documents";
import {
  flagshipRelationship,
  surpriseRoute,
  wonderfulDigitalWorld,
} from "../data/wp2-content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const humanModel = projects.find(
  (project) => project.data.slug === "the-human-model",
);
const humanModelDocument = projectDocumentForSlug("the-human-model");
const currentWork = projects.filter((project) =>
  ["bridget", "qa-agents", "career-intelligence"].includes(project.data.slug),
);
const latestMemory = (await getCollection("fieldLog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)[0];
---

<EditorialLayout
  description="Haley Parks builds and investigates personal models, persistent computational environments, and accountable agent systems."
>
  <section class="home-intro" aria-labelledby="home-title">
    <div>
      <p class="eyebrow">Haley Parks · Copenhagen</p>
      <h1 id="home-title">
        Systems for understanding people and coordinating computation.
      </h1>
      <p class="editorial-lede">
        I build and investigate personal models, agent systems, and persistent
        computational environments. This is where I share the projects,
        evidence, and working notes behind that work.
      </p>
    </div>
  </section>

  <section class="flagship-grid" aria-label="Flagship projects">
    <article class="flagship">
      <div>
        <p class="eyebrow">Flagship · human systems</p>
        <h2>{humanModel?.data.title ?? "The Human Model"}</h2>
        <p>{humanModelDocument.summary}</p>
        <p class="flagship__question">{humanModel?.data.coreQuestion}</p>
      </div>
      <div class="flagship__footer">
        <a class="text-link" href="/projects/the-human-model/"
          >Read the project report</a
        >
        <span class="meta-line">{humanModel?.data.status}</span>
      </div>
    </article>

    <article class="flagship">
      <div>
        <p class="eyebrow">{wonderfulDigitalWorld.eyebrow}</p>
        <h2>{wonderfulDigitalWorld.title}</h2>
        <p>{wonderfulDigitalWorld.summary}</p>
        <p class="flagship__question">{wonderfulDigitalWorld.coreQuestion}</p>
      </div>
      <div class="flagship__footer">
        <a
          class="text-link"
          href={wonderfulDigitalWorld.repositoryUrl}
          rel="noreferrer"
        >
          Explore the public repository ↗
        </a>
        <span class="meta-line">{wonderfulDigitalWorld.status}</span>
      </div>
    </article>
  </section>

  <section class="relationship" aria-labelledby="relationship-title">
    <p class="section-label" id="relationship-title">One inquiry, two scales</p>
    <p>{flagshipRelationship}</p>
  </section>

  <section class="current-grid" aria-labelledby="current-title">
    <div class="current-work">
      <p class="section-label" id="current-title">Current work</p>
      {
        currentWork.map((project) => (
          <article>
            <span class="meta-line">{project.data.status}</span>
            <div>
              <h3>
                <a href={`/projects/${project.data.slug}/`}>
                  {project.data.title}
                </a>
              </h3>
              <p>{project.data.summary}</p>
            </div>
          </article>
        ))
      }
    </div>

    {
      latestMemory && (
        <aside class="memory-note" aria-labelledby="memory-title">
          <p class="section-label">Latest memory</p>
          <h2 id="memory-title">
            <a href={`/field-log/${latestMemory.data.slug}/`}>
              {latestMemory.data.title}
            </a>
          </h2>
          <p>{latestMemory.data.summary}</p>
          <p class="meta-line">
            {latestMemory.data.pubDate.toLocaleDateString("en", {
              dateStyle: "medium",
            })}
          </p>
        </aside>
      )
    }
  </section>

  <div class="surprise">
    <a href={surpriseRoute.href}>
      <strong>{surpriseRoute.label}</strong>
      <span>{surpriseRoute.description} →</span>
    </a>
  </div>
</EditorialLayout>
