---
import { getCollection } from "astro:content";
import EditorialLayout from "../layouts/EditorialLayout.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const featuredProjects = projects.slice(0, 4);
const accents: Record<string, string> = {
  rust: "var(--maria-rust)",
  olive: "var(--maria-olive)",
  plum: "var(--maria-plum)",
  blue: "var(--maria-blue)",
  khaki: "#8b8053",
};
---

<EditorialLayout
  description="Haley Parks builds and investigates personal models, persistent computational environments, and accountable agent systems."
>
  <div class="maria-page">
    <section class="maria-hero" aria-labelledby="home-title">
      <div>
        <p class="maria-eyebrow">AI product engineer · Copenhagen</p>
        <h1 class="maria-title" id="home-title">Systems made for people.</h1>
      </div>
      <p class="maria-lede">
        I build and investigate personal models, agent systems, and persistent
        computational environments. This is where I share the projects,
        evidence, and working notes behind that work.
      </p>
    </section>
    <section aria-labelledby="selected-work-title">
      <div class="maria-section-heading">
        <h2 id="selected-work-title">Selected work</h2>
        <a href="/projects/">View all projects →</a>
      </div>
      <div class="maria-card-grid">
        {
          featuredProjects.map((project) => (
            <article
              class="maria-card"
              style={`--card-accent: ${accents[project.data.accent]}`}
            >
              <a href={`/projects/${project.data.slug}/`}>
                <span class="maria-card__mark" aria-hidden="true" />
                <h2>{project.data.title}</h2>
                <p>{project.data.summary}</p>
                <div class="maria-card__meta">
                  <>
                    <span>{project.data.status}</span>
                    <span>View project →</span>
                  </>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</EditorialLayout>
