---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { groupMemories, memoryGeneratedAt } from "../../data/memories";

const groups = groupMemories();
const date = (value: string | Date) =>
  new Date(value).toLocaleDateString("en", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });
const accents = ["olive", "rust", "plum", "blue"];
---

<BaseLayout
  title="Memories"
  description="A human-reviewed public record of meaningful decisions, releases, and observations across Haley Parks' work."
  canonicalPath="/memories/"
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Memories" }]}
>
  <div class="maria-page">
    <header class="maria-collection-head">
      <p class="maria-eyebrow">Public record</p>
      <h1>Memories</h1>
      <p>
        A selective, human-reviewed record of decisions, releases, and
        observations. Each entry is a public projection, not a transcript of the
        private systems behind it.
      </p>
      <p class="maria-note">
        {groups.length} published records · Evidence required · Provenance audit {
          date(memoryGeneratedAt)
        }
      </p>
    </header>

    {
      groups.length > 0 ? (
        <div class="maria-groups">
          {groups.map((group, groupIndex) => {
            const id = `group-${group.label.replaceAll(" ", "-").toLowerCase()}`;
            return (
              <section class="maria-group" aria-labelledby={id}>
                <div class="maria-section-heading">
                  <p>{String(groupIndex + 1).padStart(2, "0")}</p>
                  <h2 id={id}>{group.label}</h2>
                </div>
                <div class="maria-card-grid">
                  {group.memories.map((memory, index) => (
                    <article
                      id={memory.slug}
                      class="maria-card maria-card--content"
                    >
                      <span
                        class:list={[
                          "maria-card__mark",
                          `maria-card__mark--${accents[(groupIndex + index) % accents.length]}`,
                        ]}
                        aria-hidden="true"
                      />
                      <p class="maria-card__eyebrow">
                        <time datetime={memory.occurredAt}>
                          {date(memory.occurredAt)}
                        </time>
                        <span aria-hidden="true"> · </span>
                        {memory.kind}
                      </p>
                      <h3>
                        <a href={`#${memory.slug}`}>{memory.title}</a>
                      </h3>
                      <p>{memory.excerpt}</p>
                      <p class="maria-card__significance">
                        <strong>Why it matters.</strong> {memory.significance}
                      </p>
                      <div class="maria-card__trail">
                        <span>{memory.sourceLabel}</span>
                        {memory.publicEvidence.map((item) => (
                          <a href={item.href}>{item.label}</a>
                        ))}
                        {memory.relatedProjects.map((item) => (
                          <a href={item.href}>Related: {item.label}</a>
                        ))}
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            );
          })}
        </div>
      ) : (
        <section class="maria-boundary" aria-labelledby="memories-empty-title">
          <p class="maria-eyebrow">Current publication</p>
          <h2 id="memories-empty-title">No verified public memories yet.</h2>
          <p>
            Nothing is published here until its source and public evidence have
            been verified.
          </p>
        </section>
      )
    }

    <aside class="maria-boundary">
      <p class="maria-eyebrow">Field Log</p>
      <p>
        The historical <a href="/field-log/">Field Log</a> remains available as the
        less selective record from the edge of the work.
      </p>
    </aside>
  </div>
</BaseLayout>
