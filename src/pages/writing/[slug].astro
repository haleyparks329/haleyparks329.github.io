---
import { getCollection, render } from "astro:content";
import ExternalLink from "@/components/ExternalLink.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import WritingConnections from "@/components/WritingConnections.astro";
import WritingDocumentHeader from "@/components/WritingDocumentHeader.astro";
import {
  publishedWriting,
  validateWritingLibrary,
  writingHref,
} from "@/data/writing-library";

export async function getStaticPaths() {
  const writings = await getCollection("writing");
  const projects = await getCollection("projects");
  validateWritingLibrary(writings, projects);

  return publishedWriting(writings)
    .filter((entry) => !entry.data.routeBacked)
    .map((entry) => ({
      params: { slug: entry.data.slug },
      props: { entry, writings, projects },
    }));
}

const { entry, writings, projects } = Astro.props;
const { Content } = await render(entry);

const relatedLinks = [
  entry.data.subjectUrl &&
  entry.data.subjectUrl !== entry.data.externalSource?.url
    ? {
        href: entry.data.subjectUrl,
        label: `Visit ${entry.data.subjectName ?? "subject"}`,
        external: true,
      }
    : undefined,
  entry.data.repositoryUrl
    ? {
        href: entry.data.repositoryUrl,
        label: "Repository",
        external: true,
      }
    : undefined,
  entry.data.demoUrl
    ? {
        href: entry.data.demoUrl,
        label: "Demo",
        external: entry.data.demoUrl.startsWith("http"),
      }
    : undefined,
  entry.data.externalUrl
    ? {
        href: entry.data.externalUrl,
        label: "Open external reference",
        external: true,
      }
    : undefined,
].filter((link): link is { href: string; label: string; external: boolean } =>
  Boolean(link),
);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={writingHref(entry)}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Writing", href: "/writing/" },
    { label: entry.data.title },
  ]}
>
  <article
    class="writing-document"
    data-writing-type={entry.data.type}
    data-writing-id={entry.data.writingId}
    data-writing-collections={entry.data.collections.join(" ")}
  >
    <WritingDocumentHeader entry={entry} />
    <div class="document-body">
      <Content />
    </div>
    <WritingConnections entry={entry} writings={writings} projects={projects} />
    {
      relatedLinks.length > 0 && (
        <section class="source-links" aria-labelledby="source-links">
          <h2 id="source-links">Source links</h2>
          <ul>
            {relatedLinks.map((link) => (
              <li>
                {link.external ? (
                  <ExternalLink href={link.href} label={link.label} />
                ) : (
                  <a href={link.href}>{link.label}</a>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <p class="back-link">
      <a href="/writing/">Return to Writing</a>
    </p>
  </article>
</BaseLayout>

<style>
  .writing-document {
    width: min(var(--maria-width), calc(100% - 3rem));
    margin-inline: auto;
  }

  .document-body,
  .source-links,
  .back-link {
    width: min(100%, 44rem);
    margin-left: clamp(0rem, 6vw, 6rem);
  }

  .document-body {
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .document-body :global(h2) {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: var(--space-3);
    border-top: var(--border-width) solid var(--maria-line);
    padding-top: clamp(1.2rem, 3vw, 1.8rem);
    font-size: var(--text-h2);
    line-height: 1.08;
  }

  .document-body :global(h2:first-child) {
    margin-top: 0;
    border-top: 0;
    padding-top: 0;
  }

  .document-body :global(h3) {
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
    font-size: clamp(1.12rem, 1.5vw, 1.35rem);
    line-height: 1.15;
  }

  .document-body :global(p),
  .document-body :global(li) {
    color: var(--maria-muted);
    font-size: clamp(0.98rem, 1vw, 1.05rem);
    line-height: 1.65;
  }

  .document-body :global(p),
  .document-body :global(ul),
  .document-body :global(ol) {
    margin-bottom: var(--space-4);
  }

  .document-body :global(ul),
  .document-body :global(ol) {
    padding-left: 1.25rem;
  }

  .document-body :global(strong) {
    color: var(--maria-ink);
  }

  .document-body :global(a),
  .source-links :global(a),
  .back-link a {
    color: var(--maria-rust);
    font-weight: 600;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .document-body :global(summary:focus-visible) {
    outline: 3px solid var(--maria-blue);
    outline-offset: 4px;
  }

  .document-body :global(.exploration-kicker),
  .document-body :global(.card-label) {
    margin-bottom: var(--space-2);
    color: var(--maria-rust);
    font-family: var(--font-mono);
    font-size: var(--font-size-micro);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .document-body :global(.exploration-summary),
  .document-body :global(.status-panel),
  .document-body :global(.replay-card),
  .document-body :global(.implementation-panel) {
    border: var(--border-width) solid var(--maria-line);
    border-radius: var(--radius-md);
    padding: clamp(1rem, 3vw, 1.4rem);
    background: var(--maria-surface);
    box-shadow: var(--shadow-soft);
  }

  .document-body :global(.exploration-summary),
  .document-body :global(.status-panel) {
    margin-block: clamp(1.5rem, 4vw, 2.5rem);
  }

  .document-body :global(.exploration-summary summary) {
    cursor: pointer;
    color: var(--maria-ink);
    font-weight: 600;
  }

  .document-body :global(.exploration-summary h2),
  .document-body :global(.status-panel h2),
  .document-body :global(.replay-card h2) {
    margin-top: var(--space-5);
    border-top: 0;
    padding-top: 0;
  }

  .document-body :global(.status-panel h2),
  .document-body :global(.replay-card h2) {
    margin-top: 0;
  }

  .document-body :global(.status-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .document-body :global(.status-grid > div) {
    border-left: 0.25rem solid var(--maria-olive);
    padding-left: var(--space-4);
  }

  .document-body :global(.status-grid > div + div) {
    border-left-color: var(--maria-rust);
  }

  .document-body :global(.exploration-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .document-body :global(.button-link) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.6rem;
    border: var(--border-width) solid var(--maria-rust);
    border-radius: var(--radius-md);
    padding: 0.62rem 0.86rem;
    background: var(--maria-rust);
    color: var(--maria-paper);
    font-size: var(--font-size-small);
    font-weight: 600;
    text-decoration: none;
  }

  .document-body :global(.button-link:hover) {
    border-color: var(--maria-olive);
    background: var(--maria-olive);
    color: var(--maria-paper);
  }

  .document-body :global(.button-secondary) {
    background: transparent;
    color: var(--maria-rust);
  }

  .document-body :global(.button-secondary:hover) {
    background: color-mix(in srgb, var(--maria-rust) 10%, transparent);
    color: var(--maria-rust);
  }

  .document-body :global(.public-graph-callout h3),
  .document-body :global(.public-graph-callout p) {
    margin: 0;
  }

  .document-body :global(.public-graph-callout h3) {
    font-size: clamp(1.16rem, 1.6vw, 1.4rem);
    line-height: 1.16;
  }

  .document-body :global(.replay-card) {
    margin-block: clamp(2rem, 5vw, 3rem);
    border-color: var(--maria-blue);
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--maria-blue) 12%, transparent),
        color-mix(in srgb, var(--maria-rust) 8%, transparent)
      ),
      var(--maria-paper);
  }

  .document-body :global(.replay-metric) {
    color: var(--maria-ink);
    font-family: var(--font-mono);
    font-size: clamp(0.92rem, 1vw, 1rem);
    font-weight: 600;
  }

  .document-body :global(.implementation-panel) {
    margin-top: var(--space-4);
  }

  .document-body :global(pre) {
    overflow-x: auto;
    border: var(--border-width) solid var(--maria-line);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    background: var(--maria-surface);
    color: var(--maria-ink);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .source-links {
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    border-top: var(--border-width) solid var(--maria-line);
    padding-top: var(--space-5);
  }

  .source-links h2 {
    margin-bottom: var(--space-3);
    font-size: var(--text-h3);
  }

  .back-link {
    border-top: var(--border-width) solid var(--maria-line);
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding-top: var(--space-5);
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  @media (max-width: 680px) {
    .writing-document {
      width: min(100% - 2rem, var(--maria-width));
    }

    .document-body,
    .source-links,
    .back-link {
      margin-left: 0;
    }

    .document-body :global(.status-grid) {
      grid-template-columns: 1fr;
    }
  }
</style>
