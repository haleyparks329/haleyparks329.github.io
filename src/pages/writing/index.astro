---
import { getSubstackPosts } from "@/data/substack-feed";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/site.config";

const posts = (await getSubstackPosts()).slice(0, 6);
const date = new Intl.DateTimeFormat("en", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<BaseLayout
  title="Writing"
  description="Essays and research notes about product systems, useful evidence, and keeping human context intact."
  canonicalPath="/writing/"
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Writing" }]}
>
  <div class="maria-page writing-index">
    <header class="maria-collection-head">
      <p class="maria-eyebrow">Ideas in motion</p>
      <h1>Writing</h1>
      <p>
        Essays and research notes about product systems, useful evidence, and
        the work of keeping human context intact.
      </p>
      <a
        class="writing-index__substack"
        href={siteConfig.substackProfileUrl}
        rel="me noreferrer"
      >
        Read and subscribe on Substack <span aria-hidden="true">↗</span>
      </a>
    </header>

    {
      posts.length > 0 && (
        <section
          class="writing-recent"
          aria-labelledby="recent-writing-heading"
        >
          <header class="writing-recent__head">
            <p class="maria-eyebrow">From Substack</p>
            <h2 id="recent-writing-heading">Recent writing</h2>
          </header>
          <ol class="writing-list">
            {posts.map((post) => (
              <li>
                <article>
                  <time datetime={post.publishedAt.toISOString()}>
                    {date.format(post.publishedAt)}
                  </time>
                  <div>
                    <h3>
                      <a href={post.url} rel="noreferrer">
                        {post.title}
                      </a>
                    </h3>
                    {post.excerpt && <p>{post.excerpt}</p>}
                  </div>
                  <a
                    class="writing-list__read"
                    href={post.url}
                    rel="noreferrer"
                    aria-label={`Read ${post.title} on Substack`}
                  >
                    Read <span aria-hidden="true">↗</span>
                  </a>
                </article>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .writing-index__substack {
    display: inline-block;
    margin-top: 0.75rem;
    font-weight: 600;
    text-underline-offset: 0.2em;
  }

  .writing-recent {
    display: grid;
    grid-template-columns: minmax(12rem, 0.6fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 7vw, 7rem);
    padding-block: clamp(4rem, 8vw, 7rem) 4.5rem;
    border-top: 1px solid var(--maria-line);
  }

  .writing-recent__head h2 {
    margin: 0;
    font-family: var(--maria-display);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .writing-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .writing-list li {
    padding-block: 1.5rem;
    border-top: 1px solid var(--maria-line);
  }

  .writing-list li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .writing-list article {
    display: grid;
    grid-template-columns: 7.25rem minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: start;
  }

  .writing-list time {
    color: var(--maria-muted);
    font-size: 0.76rem;
  }

  .writing-list h3 {
    margin: 0 0 0.45rem;
    font-family: var(--maria-display);
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .writing-list h3 a {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .writing-list p {
    max-width: 58ch;
    margin: 0;
    color: var(--maria-muted);
  }

  .writing-list__read {
    font-size: 0.82rem;
    white-space: nowrap;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 48rem) {
    .writing-recent {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .writing-list article {
      grid-template-columns: 1fr auto;
    }

    .writing-list time {
      grid-column: 1 / -1;
    }
  }
</style>
