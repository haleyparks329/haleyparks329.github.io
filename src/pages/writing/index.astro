---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  collectionById,
  publishedWriting,
  validateWritingLibrary,
  writingHref,
} from "@/data/writing-library";

const allWriting = await getCollection("writing");
const projects = await getCollection("projects");
validateWritingLibrary(allWriting, projects);

const entries = publishedWriting(allWriting).sort(
  (a, b) =>
    b.data.editorialWeight - a.data.editorialWeight ||
    b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const date = new Intl.DateTimeFormat("en", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
const accents = ["olive", "rust", "plum", "blue"];
---

<BaseLayout
  title="Writing"
  description="Essays and research notes organized around recurring bodies of thought."
  canonicalPath="/writing/"
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Writing" }]}
>
  <div class="maria-page">
    <header class="maria-collection-head">
      <p class="maria-eyebrow">Ideas in motion</p>
      <h1>Writing</h1>
      <p>
        Essays and research notes about product systems, useful evidence, and
        the work of keeping human context intact.
      </p>
      <p class="maria-note">{entries.length} published pieces</p>
    </header>

    <section class="maria-card-grid" aria-label="Published writing">
      {
        entries.map((entry, index) => (
          <article class="maria-card">
            <a href={writingHref(entry)}>
              <span
                class:list={[
                  "maria-card__mark",
                  `maria-card__mark--${accents[index % accents.length]}`,
                ]}
                aria-hidden="true"
              />
              <p class="maria-card__eyebrow">
                {collectionById(entry.data.primaryCollection ?? "")?.title ??
                  "Essay"}
                <span aria-hidden="true"> · </span>
                {entry.data.readingTime}
              </p>
              <h2>{entry.data.title}</h2>
              <p>{entry.data.description}</p>
              <span class="maria-card__meta">
                {date.format(entry.data.pubDate)}
                <span aria-hidden="true"> ↗</span>
              </span>
            </a>
          </article>
        ))
      }
    </section>
  </div>
</BaseLayout>
