---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import FieldLogEntryRow from "@/components/FieldLogEntryRow.astro";
import PageIntro from "@/components/PageIntro.astro";

const entries = (await getCollection("fieldLog")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<BaseLayout
  title="Field Log"
  description="A historical archive of short public notes from Haley Parks' AI systems, build work, and research questions."
  canonicalPath="/field-log/"
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Field Log" }]}
>
  <section class="field-log-index reading-column">
    <aside class="memory-compatibility">
      <strong>Memories are now a curated public record.</strong>
      <span>This Field Log remains the historical stream of working notes.</span
      >
      <a href="/memories/">Visit Memories →</a>
    </aside>
    <PageIntro
      eyebrow="Field Log"
      title="A historical stream of working notes"
      text="Archived build observations, system questions, and decisions captured while the work was moving. Memories is the current curated record."
      meta={[`${entries.length} entries`, "Newest first", "Historical archive"]}
      accent="ochre"
      width="reading"
    />

    <section class="entry-list" aria-label="Field Log entries">
      {entries.map((entry) => <FieldLogEntryRow entry={entry} />)}
    </section>

    <nav class="field-log-page-links" aria-label="Field Log next paths">
      <a href="/explore/trails/how-i-build/">Follow the How I Build trail</a>
      <a href="/search/">Search the Field Log</a>
      <a href="/writing/">Read writing</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .field-log-index {
    margin-block: var(--space-7) var(--space-12);
  }

  .entry-list {
    margin-top: var(--space-8);
    border-top: var(--border-width) solid var(--color-border);
  }

  .memory-compatibility {
    display: grid;
    gap: 0.35rem;
    margin-bottom: var(--space-6);
    padding-block: var(--space-4);
    border-block: var(--border-width) solid var(--color-border);
    background: transparent;
  }

  .memory-compatibility a {
    width: fit-content;
    color: var(--plum);
    font-weight: 600;
  }

  .field-log-page-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.9rem;
    margin-top: var(--space-8);
    border-block: var(--border-width) solid var(--color-border);
    padding-block: var(--space-4);
  }

  .field-log-page-links a {
    color: var(--plum);
    font-size: var(--font-size-small);
    font-weight: 600;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }
</style>
