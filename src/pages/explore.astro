---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Explore"
  description="A quiet threshold for experimental and unusual public work."
  canonicalPath="/explore/"
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Explore" }]}
>
  <div class="maria-page">
    <header class="maria-collection-head">
      <p class="maria-eyebrow">Explore</p>
      <h1>The unfinished edge.</h1>
      <p>
        Experimental and unusual public work will appear here when it is ready.
      </p>
      <p class="maria-note">
        The <a href="/field-log/">Field Log</a> holds earlier working notes.
      </p>
    </header>
  </div>
</BaseLayout>
