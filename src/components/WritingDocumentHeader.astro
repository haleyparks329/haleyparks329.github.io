---
import type { CollectionEntry } from "astro:content";
import ContentTypeLabel from "@/components/ContentTypeLabel.astro";
import { collectionById } from "@/data/writing-library";

type Props = {
  entry: CollectionEntry<"writing">;
};

const { entry } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric",
});

const meta = [
  dateFormatter.format(entry.data.pubDate),
  entry.data.updatedDate
    ? `Updated ${dateFormatter.format(entry.data.updatedDate)}`
    : undefined,
  entry.data.readingTime,
  entry.data.status !== "published" ? entry.data.status : undefined,
].filter(Boolean);

const collections = entry.data.collections
  .map(collectionById)
  .filter((collection) => collection !== undefined);
---

<header class="writing-document-header">
  <ContentTypeLabel type={entry.data.type} />
  <h1>{entry.data.title}</h1>
  <p>{entry.data.description}</p>
  <ul class="document-meta" aria-label={`${entry.data.title} metadata`}>
    {meta.map((item) => <li>{item}</li>)}
    {
      entry.data.externalSource && (
        <li>
          <a href={entry.data.externalSource.url} rel="noreferrer">
            Originally published by {entry.data.externalSource.name}
          </a>
        </li>
      )
    }
  </ul>
  {
    collections.length > 0 && (
      <nav class="document-collections" aria-label="Writing collections">
        <span>Filed in</span>
        {collections.map((collection, index) => (
          <>
            <a href={`/writing/#${collection.id}`}>{collection.title}</a>
            {index < collections.length - 1 ? (
              <span aria-hidden="true">, </span>
            ) : null}
          </>
        ))}
      </nav>
    )
  }
  {
    entry.data.disclaimer && (
      <p class="document-disclaimer">{entry.data.disclaimer}</p>
    )
  }
</header>

<style>
  .writing-document-header {
    display: grid;
    gap: var(--space-4);
    max-width: 62rem;
    border-bottom: var(--border-width) solid var(--maria-line);
    padding-block: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 2.5rem);
  }

  h1 {
    max-width: 15ch;
    margin: 0;
    font-family: var(--maria-display);
    font-size: clamp(2.35rem, 4.7vw, 4.1rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .writing-document-header > p:not(.document-disclaimer) {
    max-width: 48rem;
    margin: 0;
    color: var(--maria-muted);
    font-size: clamp(1.05rem, 1.3vw, 1.2rem);
    font-weight: 400;
    line-height: 1.5;
  }

  .document-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .document-meta li {
    color: var(--maria-muted);
    font-size: var(--font-size-micro);
    font-weight: 600;
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .document-meta li + li::before {
    margin-right: 1.25rem;
    color: var(--maria-line);
    content: "/";
  }

  .document-meta a,
  .document-collections a {
    color: inherit;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .document-collections {
    color: var(--maria-muted);
    font-size: var(--font-size-small);
  }

  .document-collections > span:first-child {
    margin-right: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-micro);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .document-disclaimer {
    border-left: 0.25rem solid var(--maria-rust);
    padding-left: var(--space-3);
    color: var(--maria-muted);
    font-size: var(--font-size-small);
  }
</style>
