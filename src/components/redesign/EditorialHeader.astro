---
import { siteConfig } from "../../site.config";

const pathname = Astro.url.pathname;
const navItems = [
  { href: "/projects/", label: "Projects" },
  { href: "/writing/", label: "Writing" },
  { href: "/memories/", label: "Memories" },
  { href: "/explore/", label: "Explore" },
];

const isActive = (href: string) =>
  href === "/" ? pathname === href : pathname.startsWith(href);
---

<a class="maria-skip" href="#main-content">Skip to content</a>
<header class="maria-header">
  <div class="maria-header__inner">
    <a class="maria-brand" href="/" aria-label={`${siteConfig.name}, home`}>
      {siteConfig.name}
    </a>
    <nav class="maria-nav" aria-label="Primary navigation">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
