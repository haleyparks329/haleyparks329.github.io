---
import type { CollectionEntry } from "astro:content";
import {
  relationshipLabels,
  resolveProjectRelationships,
  resolveWritingRelationships,
  writingHref,
} from "@/data/writing-library";

type Props = {
  entry: CollectionEntry<"writing">;
  writings: CollectionEntry<"writing">[];
  projects: CollectionEntry<"projects">[];
};

const { entry, writings, projects } = Astro.props;
const relatedWriting = resolveWritingRelationships(entry, writings);
const relatedProjects = resolveProjectRelationships(entry, projects);
---

{
  (relatedWriting.length > 0 || relatedProjects.length > 0) && (
    <aside class="writing-connections" aria-labelledby="connections-title">
      <div class="connections-intro">
        <p class="section-label">Connections</p>
        <h2 id="connections-title">Follow the thought into the work</h2>
      </div>
      <div class="connection-groups">
        {relatedWriting.length > 0 && (
          <section aria-labelledby="related-writing-title">
            <h3 id="related-writing-title">Writing</h3>
            <ul>
              {relatedWriting.map(({ relationship, note, entry: related }) => (
                <li>
                  <span>{relationshipLabels[relationship]}</span>
                  <a href={writingHref(related)}>{related.data.title}</a>
                  {note && <p>{note}</p>}
                </li>
              ))}
            </ul>
          </section>
        )}
        {relatedProjects.length > 0 && (
          <section aria-labelledby="related-projects-title">
            <h3 id="related-projects-title">Projects</h3>
            <ul>
              {relatedProjects.map(({ relationship, note, project }) => (
                <li>
                  <span>{relationshipLabels[relationship]}</span>
                  <a href={`/projects/${project.data.slug}/`}>
                    {project.data.title}
                  </a>
                  {note && <p>{note}</p>}
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </aside>
  )
}

<style>
  .writing-connections {
    display: grid;
    grid-template-columns: minmax(12rem, 0.6fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 6vw, 6rem);
    max-width: 56rem;
    margin-left: clamp(0rem, 6vw, 6rem);
    margin-top: clamp(3rem, 7vw, 6rem);
    border-top: var(--border-width) solid var(--maria-line);
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .section-label,
  h3,
  li > span {
    font-family: var(--font-mono);
    font-size: var(--font-size-micro);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .section-label {
    margin: 0 0 var(--space-2);
    color: var(--maria-rust);
  }

  h2 {
    max-width: 15ch;
    margin: 0;
    font-family: var(--maria-display);
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    font-weight: 500;
    line-height: 1.08;
  }

  .connection-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  h3 {
    margin: 0 0 var(--space-3);
    color: var(--maria-muted);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    border-top: var(--border-width) solid var(--maria-line);
    padding-block: var(--space-3);
  }

  li > span {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--maria-muted);
  }

  a {
    color: var(--maria-ink);
    font-size: 1.05rem;
    font-weight: 650;
    line-height: 1.3;
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    color: var(--maria-rust);
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  li p {
    margin: var(--space-2) 0 0;
    color: var(--maria-muted);
    font-size: var(--font-size-small);
    line-height: 1.5;
  }

  @media (max-width: 760px) {
    .writing-connections,
    .connection-groups {
      grid-template-columns: 1fr;
    }

    .writing-connections {
      gap: var(--space-6);
      margin-left: 0;
    }
  }
</style>
