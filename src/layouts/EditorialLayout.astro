---
import BaseLayout from "./BaseLayout.astro";
import type { BreadcrumbItem } from "../components/Breadcrumbs.astro";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  imagePath?: string;
  breadcrumbs?: BreadcrumbItem[];
  eyebrow?: string;
}

const { eyebrow, ...layoutProps } = Astro.props;
---

<BaseLayout {...layoutProps}>
  {eyebrow && <p class="editorial-page-eyebrow">{eyebrow}</p>}
  <slot />
</BaseLayout>
