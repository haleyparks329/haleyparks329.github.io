---
import EditorialFooter from "../components/redesign/EditorialFooter.astro";
import EditorialHeader from "../components/redesign/EditorialHeader.astro";
import { siteConfig } from "../site.config";
import "../styles/global.css";
import "../styles/redesign-tokens.css";
import "../styles/wp2.css";

interface Props {
  title?: string;
  description?: string;
  eyebrow?: string;
}

const { title, description = siteConfig.description, eyebrow } = Astro.props;
const pageTitle = title
  ? `${title} · ${siteConfig.name}`
  : `${siteConfig.name} · Systems and investigations`;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
const socialImageUrl = new URL("/og.png", siteConfig.siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f5f0e7" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="An editorial illustration connecting human movement, computational models, and networked systems."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body data-redesign-foundation>
    <EditorialHeader />
    <main id="main-content" class="editorial-main">
      {eyebrow && <p class="editorial-page-eyebrow">{eyebrow}</p>}
      <slot />
    </main>
    <EditorialFooter />
  </body>
</html>
