---
// The simple site's page shell: its own head, a small header, no site-wide nav.
// The older pages keep BaseLayout; only Home and the two main project pages use this.
import { siteConfig } from "@/site.config";
import "@/styles/simple.css";

type Props = { title?: string; description?: string };

const { title, description = siteConfig.description } = Astro.props;
const pageTitle = title
  ? `${title} | ${siteConfig.name}`
  : `${siteConfig.name} | ${siteConfig.role}`;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
const imageUrl = new URL(
  "/images/haley-parks-social-card.png",
  siteConfig.siteUrl,
).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <meta name="theme-color" content="#f8f7f3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..700;1,400..600&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body class="simple-site">
    <a class="s-skip" href="#main-content">Skip to the page</a>
    <header class="s-top">
      <a class="s-me" href="/" aria-label="Haley Parks, home">
        <img src="/images/haley.jpg" alt="" width="34" height="34" />
        <span>Haley Parks</span>
      </a>
      <nav aria-label="Site">
        <a href={siteConfig.linkedinUrl}>LinkedIn</a>
      </nav>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
