---
import EditorialHeader from "@/components/redesign/EditorialHeader.astro";
import EditorialFooter from "@/components/redesign/EditorialFooter.astro";
import Breadcrumbs, {
  type BreadcrumbItem,
} from "@/components/Breadcrumbs.astro";
import { siteConfig } from "@/site.config";
import "@/styles/global.css";
import "@/styles/redesign-tokens.css";
import "@/styles/wp2.css";
import "@/styles/maria.css";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  imagePath?: string;
  breadcrumbs?: BreadcrumbItem[];
};

const {
  title = siteConfig.name,
  description = siteConfig.description,
  canonicalPath = Astro.url.pathname,
  imagePath = "/images/haley-parks-social-card.png",
  breadcrumbs,
} = Astro.props;

const pageTitle =
  title === siteConfig.name
    ? `${siteConfig.name} | ${siteConfig.role}`
    : `${title} | ${siteConfig.name}`;
const canonicalUrl = new URL(canonicalPath, siteConfig.siteUrl).toString();
const imageUrl = new URL(imagePath, siteConfig.siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <meta name="theme-color" content="#F7F6F2" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Abstract editorial shapes in Haley Parks' warm portfolio palette."
    />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{pageTitle}</title>
  </head>
  <body class="maria-site" data-redesign-foundation>
    <EditorialHeader />
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
    <main id="main-content" class="maria-main compatibility-main" tabindex="-1">
      <slot />
    </main>
    <EditorialFooter />
  </body>
</html>
